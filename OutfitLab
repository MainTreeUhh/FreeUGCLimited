c:AddToggle({
   text = "Auto Spin Wheel",
   state = false,
   callback = function(e)
       if e then
           getgenv().f = true
           getgenv().g = task.spawn(function()
               while getgenv().f do
                   game:GetService("ReplicatedStorage").SpinWheel:InvokeServer("spin")
                   task.wait(3)
               end
           end)
       else
           getgenv().f = false
       end
   end
})

c:AddToggle({
   text = "Auto Compete Show",
   state = false,
   callback = function(h)
       if h then
           getgenv().i = true
           getgenv().j = task.spawn(function()
               while getgenv().i do
                   game.Players.LocalPlayer.Character:PivotTo(workspace.ContestantPad.Field:GetPivot())
                   task.wait(5)
               end
           end)
       else
           getgenv().i = false
       end
   end
})

